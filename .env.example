# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never import from a Client Component.
# Used for platform-admin views and the demo seed script.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI -----------------------------------------------------------------
# lib/ai/provider.ts. Get a key at https://console.anthropic.com/
# SERVER-ONLY — used in API routes / Server Actions, never sent to the browser.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron -------------------------------------------------------------------
# Protects /api/cron/follow-ups. Vercel sends this automatically as a Bearer
# token when the deployment has a CRON_SECRET env var set — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=

# --- Stripe -------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use a test-mode key (sk_test_...) until
# you're ready to take real payments.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks (or `stripe listen` locally) -> signing secret.
STRIPE_WEBHOOK_SECRET=
# Price ids from `npx tsx scripts/setup-stripe-products.ts` (creates them for you).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
